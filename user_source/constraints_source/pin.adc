set_pin_assignment	{ IO_cam_scl }	{ LOCATION = M18; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }	{ LOCATION = N22; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_led }	{ LOCATION = T6; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
# anPH1A schematic: bank32 VDD_DDRIO=1.5V, SW2=K4, SW3=P5 (active low).
set_pin_assignment	{ I_key_in }	{ LOCATION = K4; IOSTANDARD = LVCMOS15; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_key_next_n }	{ LOCATION = P5; IOSTANDARD = LVCMOS15; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_sys_clk_25m }	{ LOCATION = N18; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_clk_27m }	{ LOCATION = K22; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_cam_rst_n }	{ LOCATION = L21; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_hdmi_tx_p[0] }	{ LOCATION = V13; IOSTANDARD = LVDS25; PULLTYPE = NONE; }
set_pin_assignment	{ O_hdmi_tx_p[1] }	{ LOCATION = Y12; IOSTANDARD = LVDS25; PULLTYPE = NONE; }
set_pin_assignment	{ O_hdmi_tx_p[2] }	{ LOCATION = T13; IOSTANDARD = LVDS25; PULLTYPE = NONE; }
set_pin_assignment	{ O_hdmi_clk_p }	{ LOCATION = V17; IOSTANDARD = LVDS25; PULLTYPE = NONE; }
set_pin_assignment	{ fan_pwm }	{ LOCATION = D12; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# ---- SD 卡 SPI（拍照存卡）------------------------------------------------
# 引脚与电平标准逐一对应 new_try/sd_card_spi 例程（同一块 PH1A90SBG484 板）。
# MISO 给 PULLUP：卡没插或卡在初始化前处于高阻时，不要让输入浮空飘出假数据。
set_pin_assignment	{ O_sd_clk }	{ LOCATION = P17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_sd_cs }	{ LOCATION = R21; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ I_sd_miso }	{ LOCATION = P22; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_sd_mosi }	{ LOCATION = P21; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }




set_inst_assignment { u_mipi_dphy_rx_ph1a_mipiio_wrapper/u_ph1a_mipiio_wrapper/u_PH1_PHY_MIPIIO } { location=X5Y0Z0; }  #dphy0位置是X5Y0Z0，dphy1位置是X5Y20Z0

